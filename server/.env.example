# Copy to `.env` to override the defaults below.

NODE_ENV=development
PORT=5000

# Comma-separated list of origins allowed to call the API (CORS).
CLIENT_ORIGIN=http://localhost:5173

# Where customer photos are stored, relative to the server/ folder.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# PostgreSQL. Without it, data is kept in memory (development only; required in production).
# The tables are created on startup. Keep the real value only in `.env` (never commit it).
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/Zauq_DB
# For a hosted database that needs TLS (e.g. Amazon RDS):
# DATABASE_SSL=true

# The shop's web address, for links and images in emails (in production: https://zauqframes.com).
# PUBLIC_URL=http://localhost:5173

# Order emails. Without SMTP_HOST they are saved to server/outbox/ (development) instead.
# Any SMTP service works — e.g. Amazon SES (email-smtp.ap-southeast-2.amazonaws.com), Brevo, Zoho.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Zauq Frames <orders@zauqframes.com>
# MAIL_REPLY_TO=zauqframes.store@gmail.com
# A copy of every order email for the studio (optional):
# MAIL_BCC=
