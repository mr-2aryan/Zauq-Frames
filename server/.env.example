# Copy to `.env` to override the defaults below.

NODE_ENV=development
PORT=5000

# Comma-separated list of origins allowed to call the API (CORS).
CLIENT_ORIGIN=http://localhost:5173

# Where customer photos are stored, relative to the server/ folder.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# Database — to be decided.
# DATABASE_URL=
